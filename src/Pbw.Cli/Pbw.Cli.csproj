<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Pbw.Core\Pbw.Core.csproj" />
    <ProjectReference Include="..\Pbw.Windows\Pbw.Windows.csproj" />
    <ProjectReference Include="..\Pbw.Mcp\Pbw.Mcp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pbw</AssemblyName>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
